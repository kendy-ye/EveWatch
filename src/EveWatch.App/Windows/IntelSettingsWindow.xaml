<Window x:Class="EveWatch.App.Windows.IntelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="频道预警"
        Width="920" Height="760" MinWidth="820" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource BodyFont}">

  <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
          BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <!-- ================= 标题 ================= -->
      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="频道预警" FontFamily="{StaticResource DisplayFont}" FontSize="13" />
            <TextBlock Style="{StaticResource DimText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Text="读取 EVE 聊天日志，用角色当前位置计算跳数并播放对应报警" />
          </StackPanel>
          <Button Style="{StaticResource BtnGhost}" Width="42" Height="42" Padding="0"
                  Content="✕" HorizontalAlignment="Right" Click="OnCloseClick" ToolTip="关闭" />
        </Grid>
      </Border>

      <!-- ================= 主体 ================= -->
      <Border Grid.Row="1" Margin="14,12,14,0"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="16,14,16,18">
          <StackPanel>
            <!-- 基础 -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="频道预警" Style="{StaticResource ColumnTitle}" />
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="从本地频道识别当前位置，再从监听的预警频道读取星系名并按跳数规则报警。" />
                  </StackPanel>
                  <CheckBox x:Name="IntelEnabledCheck" Grid.Column="1" Content="启用"
                            VerticalAlignment="Center" Click="OnIntelEnabledChanged" />
                </Grid>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ChatLogDirectoryBox" Height="30" VerticalContentAlignment="Center"
                           LostFocus="OnChatLogDirectoryLostFocus"
                           ToolTip="默认显示自动检测到的 EVE 聊天日志目录；也可以手动修改或浏览选择" />
                  <Button Grid.Column="1" Style="{StaticResource BtnMini}" Height="30" Content="浏览"
                          Margin="7,0,0,0" Click="OnBrowseLogDirectoryClick" />
                  <Button Grid.Column="2" Style="{StaticResource BtnMini}" Height="30" Content="重新扫描"
                          Margin="6,0,0,0" Click="OnRescanIntelClick" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <CheckBox x:Name="IgnoreSelfCheck" Content="忽略自己发送的消息"
                            Click="OnIgnoreSelfChanged" VerticalAlignment="Center" />
                  <TextBlock Style="{StaticResource DimText}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Text="关闭后，自己发的星系也会触发（用于测试）" />
                </StackPanel>

                <TextBlock x:Name="IntelStatusText" Style="{StaticResource DimText}" TextWrapping="Wrap"
                           Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <!-- 监听 -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="监听账号与频道" Style="{StaticResource ColumnTitle}" />
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="同一账号可以监听多个频道。频道列表来自最近 30 天日志；未找到的频道可以手动输入，出现日志后自动绑定。" />

                <ItemsControl x:Name="ListenerList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CharacterName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CharacterIdText}" Style="{StaticResource DimText}" FontSize="9" />
                          </StackPanel>

                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ChannelName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ChannelIdText}" Style="{StaticResource DimText}" FontSize="8.5"
                                       FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>

                          <TextBlock Grid.Column="2" Text="{Binding CurrentSystem}" FontSize="10"
                                     Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="9"
                                     Foreground="{StaticResource PrimaryHiBrush}" VerticalAlignment="Center" />

                          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnMini}" Height="24" Content="{Binding EnabledText}"
                                    Tag="{Binding}" Click="OnListenerToggleClick" />
                            <Button Style="{StaticResource BtnMini}" Height="24" Content="删除" Margin="5,0,0,0"
                                    Tag="{Binding}" Click="OnListenerDeleteClick" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="ListenerEmptyText" Style="{StaticResource DimText}" Margin="0,7,0,0"
                           Text="还没有监听项。在下方频道探测中选择频道，或手动输入。" />

                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Text="频道探测" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
                    <Grid Margin="0,7,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="ProbeCharacterCombo" Height="28"
                                SelectionChanged="OnProbeCharacterChanged">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1" Style="{StaticResource BtnMini}" Height="28" Content="重新扫描"
                              Margin="7,0,0,0" Click="OnRescanIntelClick" />
                      <TextBlock Grid.Column="2" x:Name="ProbeHint" Style="{StaticResource DimText}"
                                 VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ListBox x:Name="ProbeChannelList" Height="112" Margin="0,7,0,0"
                             Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                             SelectionMode="Multiple">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="170" />
                              <ColumnDefinition Width="90" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="10.5" />
                            <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="9"
                                       Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Id}" FontSize="8.5"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,7,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="ManualChannelBox" Height="28" VerticalContentAlignment="Center"
                               ToolTip="输入频道名或 Channel ID" />
                      <Button Grid.Column="1" Style="{StaticResource BtnMini}" Height="28" Content="添加手动频道"
                              Margin="7,0,0,0" Click="OnAddManualChannelClick" />
                      <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Height="28" Content="添加选中频道"
                              Margin="7,0,0,0" Click="OnAddSelectedChannelsClick" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- 规则 -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="预警规则" Style="{StaticResource ColumnTitle}" />
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="区间为闭区间，列表顺序即优先级；可添加多条，例如 1-2、3-5、6-10。消息含 clr 时视为安全，不报警。" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Height="28" Content="添加规则"
                          VerticalAlignment="Center" Click="OnAddRuleClick" />
                </Grid>

                <ItemsControl x:Name="RuleList" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Text="{Binding OrderText}" Style="{StaticResource DimText}" FontSize="9"
                                     VerticalAlignment="Center" />
                          <TextBox Grid.Column="1" Height="27" Text="{Binding MinJumps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   LostFocus="OnRuleFieldLostFocus" VerticalContentAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="–" Style="{StaticResource DimText}" FontSize="9"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <TextBox Grid.Column="3" Height="27" Text="{Binding MaxJumps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                   LostFocus="OnRuleFieldLostFocus" VerticalContentAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="跳" Style="{StaticResource DimText}" FontSize="8.5"
                                     VerticalAlignment="Center" />

                          <ComboBox Grid.Column="5" Height="27" ItemsSource="{Binding SoundOptions}"
                                    SelectedValuePath="Id"
                                    SelectedValue="{Binding SoundId, Mode=TwoWay}"
                                    SelectionChanged="OnRuleSoundChanged">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>

                          <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="64" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
                                    ValueChanged="OnRuleSliderChanged" PreviewMouseLeftButtonUp="OnRuleSliderCommit"
                                    LostFocus="OnRuleSliderCommit" />
                            <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Style="{StaticResource DimText}"
                                       FontSize="8.5" Width="28" TextAlignment="Right" />
                          </StackPanel>

                          <CheckBox Grid.Column="7" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                    Click="OnRuleEnabledClick" VerticalAlignment="Center" />

                          <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnMini}" Height="23" Width="24" Content="↑"
                                    Tag="{Binding}" Click="OnRuleUpClick" />
                            <Button Style="{StaticResource BtnMini}" Height="23" Width="24" Content="↓"
                                    Margin="3,0,0,0" Tag="{Binding}" Click="OnRuleDownClick" />
                            <Button Style="{StaticResource BtnMini}" Height="23" Content="试听"
                                    Margin="3,0,0,0" Tag="{Binding}" Click="OnRulePreviewClick" />
                            <Button Style="{StaticResource BtnMini}" Height="23" Content="删除"
                                    Margin="3,0,0,0" Tag="{Binding}" Click="OnRuleDeleteClick" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="RuleHint" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>

            <!-- 弹窗 -->
            <Border Style="{StaticResource Card}" Padding="12">
              <StackPanel>
                <TextBlock Text="弹窗设置" Style="{StaticResource ColumnTitle}" />
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="位置、尺寸、透明度与显示内容。拖动弹窗标题栏后会自动切换为自定义位置并保存。" />

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Text="位置模式" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="PositionModeCombo" Grid.Column="1" Height="28" Margin="0,0,0,8"
                            SelectedValuePath="Tag" SelectionChanged="OnPopupSettingChanged">
                    <ComboBoxItem Content="锚点" Tag="anchor" />
                    <ComboBoxItem Content="自定义坐标" Tag="custom" />
                  </ComboBox>

                  <TextBlock Grid.Row="1" Text="锚点" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="AnchorCombo" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,8"
                            SelectedValuePath="Tag" SelectionChanged="OnPopupSettingChanged">
                    <ComboBoxItem Content="右上角" Tag="top-right" />
                    <ComboBoxItem Content="左上角" Tag="top-left" />
                    <ComboBoxItem Content="右下角" Tag="bottom-right" />
                    <ComboBoxItem Content="左下角" Tag="bottom-left" />
                    <ComboBoxItem Content="屏幕居中" Tag="center" />
                    <ComboBoxItem Content="ROI 并排窗旁" Tag="wall-side" />
                  </ComboBox>

                  <TextBlock Grid.Row="2" Text="目标显示器" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="MonitorCombo" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,8"
                            SelectionChanged="OnPopupSettingChanged">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Grid.Row="3" Text="窗口尺寸" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="SizeCombo" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,8"
                            SelectedValuePath="Tag" SelectionChanged="OnPopupSettingChanged">
                    <ComboBoxItem Content="紧凑" Tag="compact" />
                    <ComboBoxItem Content="标准" Tag="standard" />
                    <ComboBoxItem Content="大" Tag="large" />
                  </ComboBox>

                  <TextBlock Grid.Row="4" Text="不透明度" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="OpacitySlider" Minimum="65" Maximum="100" Value="100"
                            ValueChanged="OnOpacityChanged" PreviewMouseLeftButtonUp="OnOpacityCommit"
                            LostFocus="OnOpacityCommit" VerticalAlignment="Center" />
                    <TextBlock x:Name="OpacityText" Grid.Column="1" Text="100%" Style="{StaticResource DimText}"
                               FontSize="9" VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>

                  <TextBlock Grid.Row="5" Text="自动关闭" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="AutoCloseCombo" Grid.Row="5" Grid.Column="1" Height="28" Margin="0,0,0,8"
                            SelectedValuePath="Tag" SelectionChanged="OnPopupSettingChanged">
                    <ComboBoxItem Content="不自动关闭" Tag="0" />
                    <ComboBoxItem Content="5 秒" Tag="5" />
                    <ComboBoxItem Content="10 秒" Tag="10" />
                    <ComboBoxItem Content="30 秒" Tag="30" />
                  </ComboBox>

                  <TextBlock Grid.Row="6" Text="视图" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <ComboBox x:Name="ViewModeCombo" Grid.Row="6" Grid.Column="1" Height="28" Margin="0,0,0,8"
                            SelectedValuePath="Tag" SelectionChanged="OnPopupSettingChanged">
                    <ComboBoxItem Content="路线" Tag="route" />
                    <ComboBoxItem Content="邻域" Tag="neighborhood" />
                  </ComboBox>

                  <TextBlock Grid.Row="7" Text="显示内容" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,8" />
                  <WrapPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                    <CheckBox x:Name="ShowRegionCheck" Content="星域" Margin="0,0,14,0" Click="OnPopupSettingChanged" />
                    <CheckBox x:Name="ShowSecurityCheck" Content="安全等级" Margin="0,0,14,0" Click="OnPopupSettingChanged" />
                    <CheckBox x:Name="ShowChannelCheck" Content="频道" Margin="0,0,14,0" Click="OnPopupSettingChanged" />
                    <CheckBox x:Name="ShowCharacterCheck" Content="角色" Margin="0,0,14,0" Click="OnPopupSettingChanged" />
                    <CheckBox x:Name="ShowSoundCheck" Content="声音" Click="OnPopupSettingChanged" />
                    <CheckBox x:Name="TopmostCheck" Content="置顶" Margin="14,0,0,0" Click="OnPopupSettingChanged" />
                  </WrapPanel>

                  <TextBlock Grid.Row="8" Text="自定义坐标" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="PlacementXBox" Width="74" Height="27" VerticalContentAlignment="Center"
                             ToolTip="窗口左上角 X 坐标（WPF 单位）" />
                    <TextBlock Text="," Style="{StaticResource DimText}" Margin="5,0" VerticalAlignment="Center" />
                    <TextBox x:Name="PlacementYBox" Width="74" Height="27" VerticalContentAlignment="Center"
                             ToolTip="窗口左上角 Y 坐标（WPF 单位）" />
                    <Button Style="{StaticResource BtnMini}" Height="27" Content="应用坐标" Margin="7,0,0,0"
                            Click="OnApplyCoordinatesClick" />
                    <Button Style="{StaticResource BtnGhost}" Height="27" Content="使用当前位置" Margin="6,0,0,0"
                            Click="OnUseCurrentPositionClick" />
                    <Button Style="{StaticResource BtnGhost}" Height="27" Content="恢复默认" Margin="6,0,0,0"
                            Click="OnResetPopupPositionClick" />
                  </StackPanel>
                </Grid>

                <TextBlock x:Name="PopupHint" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ================= 底部操作 ================= -->
      <Grid Grid.Row="2" Margin="16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource DimText}" VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="频道预警在后台持续运行；关闭此窗口不会停止监听。" />

        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="关闭" MinWidth="88"
                Click="OnCloseClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
