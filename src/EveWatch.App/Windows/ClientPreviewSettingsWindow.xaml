<Window x:Class="EveWatch.App.Windows.ClientPreviewSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="客户端预览设置"
        Width="820" Height="760" MinWidth="760" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource BodyFont}"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">

  <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
          BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
        <RowDefinition Height="62" />
      </Grid.RowDefinitions>

      <!-- ================= 标题 ================= -->
      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="客户端预览设置" FontFamily="{StaticResource DisplayFont}" FontSize="13" />
            <TextBlock Style="{StaticResource DimText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Text="每个角色一个预览窗，可摆到任意显示器并记住位置" />
          </StackPanel>
          <Button Style="{StaticResource BtnGhost}" Width="42" Height="42" Padding="0"
                  Content="✕" HorizontalAlignment="Right" Click="OnCloseClick" ToolTip="关闭" />
        </Grid>
      </Border>

      <!-- ================= 主体 ================= -->
      <Border Grid.Row="1" Margin="14,12,14,0"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,14,16,18">
          <StackPanel>
            <!-- 全局 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="全局" Style="{StaticResource ColumnTitle}" />
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="总开关只影响本次运行，不改写逐角色配置。透明度只作用于画面；角色名与焦点描边画在独立的透明覆盖层上。" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Text="显示预览" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <CheckBox x:Name="SessionCheck" Grid.Column="1" Content="本次运行开启预览"
                            VerticalAlignment="Center" Margin="0,0,0,10" Click="OnSessionChanged" />

                  <TextBlock Grid.Row="1" Text="置顶显示" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <CheckBox x:Name="TopmostCheck" Grid.Row="1" Grid.Column="1" Content="预览窗始终在其它窗口之上"
                            VerticalAlignment="Center" Margin="0,0,0,10" Click="OnSettingChanged" />

                  <TextBlock Grid.Row="2" Text="默认宽 × 高" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="DefaultWidthBox" Width="72" Height="27" VerticalContentAlignment="Center"
                             LostFocus="OnDefaultSizeLostFocus" KeyDown="OnSizeBoxKeyDown"
                             ToolTip="预览窗宽度，140–800" />
                    <TextBlock Text="×" Style="{StaticResource DimText}" Margin="6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="DefaultHeightBox" Width="72" Height="27" VerticalContentAlignment="Center"
                             LostFocus="OnDefaultSizeLostFocus" KeyDown="OnSizeBoxKeyDown"
                             ToolTip="预览窗高度，100–600" />
                    <TextBlock Style="{StaticResource DimText}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="回车或点开别处即刻应用到所有预览窗" />
                  </StackPanel>

                  <TextBlock Grid.Row="3" Text="透明度" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" VerticalAlignment="Center"
                            ValueChanged="OnOpacityChanged" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" Style="{StaticResource DimText}"
                               FontSize="10" VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>

                  <TextBlock Grid.Row="4" Text="焦点描边颜色" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="ColorSwatch" Width="30" Height="27" CornerRadius="4"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                    <TextBox x:Name="ColorHexBox" Width="84" Height="27" Margin="7,0,0,0"
                             VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"
                             LostFocus="OnColorHexLostFocus" ToolTip="HEX 颜色，例如 #3DDC84" />
                    <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                      <Border Width="18" Height="18" CornerRadius="3" Background="#3DDC84" Tag="#3DDC84"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="绿色（默认）" MouseLeftButtonDown="OnColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#22D3EE" Tag="#22D3EE"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="青色" MouseLeftButtonDown="OnColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#F0A02A" Tag="#F0A02A"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="琥珀" MouseLeftButtonDown="OnColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#FF4D4D" Tag="#FF4D4D"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="红色" MouseLeftButtonDown="OnColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#A78BFA" Tag="#A78BFA"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="紫色" MouseLeftButtonDown="OnColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#E3EBF2" Tag="#E3EBF2"
                              Cursor="Hand" ToolTip="白色" MouseLeftButtonDown="OnColorPresetClick" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Grid.Row="5" Text="焦点描边粗细" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BorderWidthSlider" Minimum="0" Maximum="6" VerticalAlignment="Center"
                            ValueChanged="OnBorderWidthChanged" />
                    <TextBlock x:Name="BorderWidthValueText" Grid.Column="1" Style="{StaticResource DimText}"
                               FontSize="10" VerticalAlignment="Center" TextAlignment="Right" />
                  </Grid>

                  <TextBlock Grid.Row="6" Text="角色名颜色" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="LabelColorSwatch" Width="30" Height="27" CornerRadius="4"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                    <TextBox x:Name="LabelColorHexBox" Width="84" Height="27" Margin="7,0,0,0"
                             VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"
                             LostFocus="OnLabelColorHexLostFocus" ToolTip="角色名的统一颜色，例如 #E3EBF2" />
                    <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                      <Border Width="18" Height="18" CornerRadius="3" Background="#E3EBF2" Tag="#E3EBF2"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="白色" MouseLeftButtonDown="OnLabelColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#F0A02A" Tag="#F0A02A"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="琥珀" MouseLeftButtonDown="OnLabelColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#3DDC84" Tag="#3DDC84"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="绿色" MouseLeftButtonDown="OnLabelColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#22D3EE" Tag="#22D3EE"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="青色" MouseLeftButtonDown="OnLabelColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#FF7AA2" Tag="#FF7AA2"
                              Cursor="Hand" Margin="0,0,5,0" ToolTip="粉色" MouseLeftButtonDown="OnLabelColorPresetClick" />
                      <Border Width="18" Height="18" CornerRadius="3" Background="#8A98A6" Tag="#8A98A6"
                              Cursor="Hand" ToolTip="灰色" MouseLeftButtonDown="OnLabelColorPresetClick" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Grid.Row="7" Text="角色名" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,0,10" />
                  <CheckBox x:Name="ShowLabelCheck" Grid.Row="7" Grid.Column="1" Content="在画面左上角显示角色名（粗体）"
                            VerticalAlignment="Center" Margin="0,0,0,10" Click="OnSettingChanged" />

                  <TextBlock Grid.Row="8" Text="客户端最小化时" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                  <CheckBox x:Name="HideMinCheck" Grid.Row="8" Grid.Column="1" Content="隐藏该预览（推荐，避免画面停更）"
                            VerticalAlignment="Center" Click="OnSettingChanged" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource BtnMini}" Content="自动排列" Height="27" Click="OnAutoArrangeClick"
                          ToolTip="把运行中的客户端从主屏左上角开始排列，每行 5 个" />
                  <Button Style="{StaticResource BtnMini}" Content="重置全部位置" Height="27" Margin="7,0,0,0"
                          Click="OnResetPositionsClick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 逐角色 -->
            <Border Style="{StaticResource Card}" Padding="14">
              <StackPanel>
                <TextBlock Text="角色预览" Style="{StaticResource ColumnTitle}" />
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="取消勾选只隐藏该角色的预览，不影响 ROI 监控与预警；尺寸与位置修改后立即生效。" />

                <Grid Margin="0,10,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="48" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="角色" Style="{StaticResource DimText}" FontSize="9" />
                  <TextBlock Grid.Column="1" Text="显示" Style="{StaticResource DimText}" FontSize="9" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="宽" Style="{StaticResource DimText}" FontSize="9" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="高" Style="{StaticResource DimText}" FontSize="9" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="透明度" Style="{StaticResource DimText}" FontSize="9" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="位置" Style="{StaticResource DimText}" FontSize="9" />
                </Grid>

                <ItemsControl x:Name="AccountList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="48" />
                          </Grid.ColumnDefinitions>

                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RunningText}" Style="{StaticResource DimText}" FontSize="9" />
                          </StackPanel>

                          <CheckBox Grid.Column="1" IsChecked="{Binding Visible, Mode=TwoWay}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Tag="{Binding}" Click="OnRowVisibleClick" />

                          <TextBox Grid.Column="2" Height="26" Margin="0,0,4,0" FontSize="11"
                                   VerticalContentAlignment="Center" Tag="{Binding}"
                                   Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                   LostFocus="OnRowSizeLostFocus" KeyDown="OnSizeBoxKeyDown" />
                          <TextBox Grid.Column="3" Height="26" Margin="0,0,4,0" FontSize="11"
                                   VerticalContentAlignment="Center" Tag="{Binding}"
                                   Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}"
                                   LostFocus="OnRowSizeLostFocus" KeyDown="OnSizeBoxKeyDown" />

                          <ComboBox Grid.Column="4" Height="26" Margin="0,0,4,0" FontSize="10"
                                    Tag="{Binding}" SelectionChanged="OnRowOpacityChanged"
                                    SelectedIndex="{Binding OpacityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="跟随" />
                            <ComboBoxItem Content="90%" />
                            <ComboBoxItem Content="80%" />
                            <ComboBoxItem Content="70%" />
                            <ComboBoxItem Content="60%" />
                          </ComboBox>

                          <TextBlock Grid.Column="5" Text="{Binding PositionText}" Style="{StaticResource DimText}"
                                     FontSize="9" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />

                          <Button Grid.Column="6" Style="{StaticResource BtnMini}" Height="23" Content="重置"
                                  Margin="4,0,0,0" Tag="{Binding}" Click="OnRowResetClick" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="RowHint" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <!-- 客户端分组与分组快捷键 -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="客户端分组与快捷键" Style="{StaticResource ColumnTitle}" />
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="把客户端分到不同组，为每组单独绑定切换快捷键。组内列表顺序即循环顺序；离线和隐藏的客户端会自动跳过。" />

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="选择分组" Style="{StaticResource DimText}" VerticalAlignment="Center" />

                  <ComboBox x:Name="GroupCombo" Grid.Column="1" Height="30" Margin="0,0,8,0"
                            SelectionChanged="OnGroupSelectionChanged">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Height="30" Content="新建分组"
                          Margin="0,0,6,0" Click="OnAddGroupClick" />
                  <Button Grid.Column="3" Style="{StaticResource BtnDanger}" Height="30" Content="删除当前分组"
                          Click="OnDeleteGroupClick" />
                </Grid>

                <TextBlock x:Name="GroupEmptyHint" Style="{StaticResource DimText}" TextWrapping="Wrap"
                           Margin="0,9,0,0" Visibility="Collapsed"
                           Text="还没有分组。点「新建分组」创建后，再把客户端加进组里并绑定快捷键。" />

                <StackPanel x:Name="GroupEditor" Margin="0,12,0,0">
                  <Border Height="1" Background="{StaticResource BorderBrush}" />
                  <TextBlock x:Name="GroupEditorTitle" Text="分组设置" Style="{StaticResource ColumnTitle}" Margin="0,10,0,0" />
                  <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                             Text="名称用于在上方下拉框中区分分组；组内顺序决定快捷键的循环顺序。" />

                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="分组名称" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                    <TextBox x:Name="GroupNameBox" Grid.Column="1" Height="28"
                             VerticalContentAlignment="Center" LostFocus="OnGroupNameLostFocus"
                             ToolTip="修改后离开输入框即保存" />
                  </Grid>

                  <TextBlock Text="组内客户端（从上到下循环）" Style="{StaticResource DimText}" Margin="0,10,0,4" />

                  <ItemsControl x:Name="GroupMemberList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="MemberName" Text="{Binding Name}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <Border x:Name="MemberBadge" Grid.Column="1"
                                    Background="{StaticResource Surface3Brush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="{Binding BadgeText}" FontSize="8.5"
                                         Foreground="{StaticResource TextDimBrush}" />
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                              <Button Style="{StaticResource BtnMini}" Height="23" Width="24" Content="↑"
                                      Tag="{Binding}" Click="OnGroupMemberUpClick" />
                              <Button Style="{StaticResource BtnMini}" Height="23" Width="24" Content="↓"
                                      Margin="3,0,0,0" Tag="{Binding}" Click="OnGroupMemberDownClick" />
                              <Button Style="{StaticResource BtnMini}" Height="23" Content="移除"
                                      Margin="3,0,0,0" Tag="{Binding}" Click="OnGroupMemberRemoveClick" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsRunning}" Value="False">
                            <Setter TargetName="MemberName" Property="Foreground"
                                    Value="{StaticResource TextDimBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock x:Name="GroupEmptyText" Style="{StaticResource DimText}"
                             Text="该分组还没有客户端。" Margin="0,6,0,0" Visibility="Collapsed" />

                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="GroupAccountCombo" Height="28">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1" Style="{StaticResource BtnMini}" Height="28" Content="添加到组"
                            Margin="7,0,0,0" Click="OnAddGroupMemberClick" />
                  </Grid>

                  <TextBlock Text="分组快捷键" Style="{StaticResource DimText}" Margin="0,12,0,4" />

                  <ItemsControl x:Name="GroupHotkeyList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Text="{Binding Action.Name}" FontSize="11" VerticalAlignment="Center" />

                          <Border Grid.Column="1" Height="28" CornerRadius="6" BorderThickness="1"
                                  Margin="10,0" VerticalAlignment="Center"
                                  Background="{StaticResource Surface3Brush}"
                                  BorderBrush="{StaticResource BorderStrongBrush}">
                            <TextBlock Text="{Binding DisplayText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="6,0" />
                          </Border>

                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnMini}" Height="26" Content="绑定"
                                    Tag="{Binding}" Click="OnBindClick" />
                            <Button Style="{StaticResource BtnMini}" Height="26" Content="清除"
                                    Margin="6,0,0,0" Tag="{Binding}" Click="OnClearClick"
                                    IsEnabled="{Binding HasBinding}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock x:Name="GroupHintText" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,2,0,0" />

                  <Border x:Name="GroupErrorBox" Visibility="Collapsed"
                          Background="{StaticResource DangerDimBrush}" BorderBrush="#55FF4D4D"
                          BorderThickness="1" CornerRadius="6" Padding="11,9" Margin="0,10,0,0">
                    <TextBlock x:Name="GroupErrorText" TextWrapping="Wrap" FontSize="11.5" Foreground="#FFFF9090" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ================= 底部 ================= -->
      <Grid Grid.Row="2" Margin="16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource DimText}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="左键单击预览窗切到对应客户端；右键按住拖动窗位置；拖边缘缩放。关闭此窗口不会关闭预览。" />

        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="关闭" MinWidth="88"
                Click="OnCloseClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
