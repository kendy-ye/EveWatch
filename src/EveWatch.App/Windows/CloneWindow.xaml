<Window x:Class="EveWatch.App.Windows.CloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="克隆设置"
        Width="500" SizeToContent="Height" MaxHeight="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource BodyFont}">

  <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
          BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ================= 标题 ================= -->
      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Path Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource PrimaryBrush}"
                Data="M2,0 H12 V2 H4 V12 H2 Z M0,3 H10 V15 H0 Z" />
          <TextBlock Text="克隆设置" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                     Margin="9,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- ================= 主体 ================= -->
      <StackPanel Grid.Row="1" Margin="16,14,16,0">

        <!-- 基准账号可选 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="66" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="基准账号" Style="{StaticResource DimText}" VerticalAlignment="Center" />
          <ComboBox x:Name="SourceCombo" Grid.Column="1" SelectionChanged="OnSourceChanged"
                    ToolTip="被复制的账号">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- 目标账号多选 -->
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="66" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="目标账号" Style="{StaticResource DimText}" VerticalAlignment="Center" />
          <TextBlock x:Name="TargetCountText" Grid.Column="1" Style="{StaticResource DimText}"
                     VerticalAlignment="Center" Margin="9,0,0,0" />

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource BtnMini}" Content="全选" Click="OnSelectAllTargetsClick" />
            <Button Style="{StaticResource BtnMini}" Content="反选" Click="OnInvertTargetsClick" />
            <Button Style="{StaticResource BtnMini}" Content="清空" Click="OnClearTargetsClick" />
          </StackPanel>
        </Grid>

        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" MaxHeight="176">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,4">
            <ItemsControl x:Name="TargetList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="2,3"
                            Checked="OnTargetToggled" Unchecked="OnTargetToggled">
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- 克隆项 -->
        <TextBlock Text="克隆项" Style="{StaticResource ColumnTitle}" Margin="0,16,0,0" />

        <StackPanel Margin="0,4,0,0">
          <CheckBox x:Name="ChkRois" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
            <StackPanel Margin="0,1,0,3">
              <TextBlock Text="ROI 列表与区域" FontSize="12.5" />
              <TextBlock Text="含每个 ROI 的名称、坐标、尺寸与启用状态" Style="{StaticResource DimText}" Margin="0,1,0,0" />
              <TextBlock Text="坐标是相对窗口内容区的，只有目标账号的游戏内界面布局与基准账号一致时才成立；布局不同会把区域落到别的窗口上。默认不克隆。"
                         FontSize="10.5" Foreground="#FFB98A48" TextWrapping="Wrap" MaxWidth="430" Margin="0,3,0,0" />
            </StackPanel>
          </CheckBox>

          <CheckBox x:Name="ChkColors" IsChecked="True" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
            <StackPanel Margin="0,1,0,3">
              <TextBlock Text="命中颜色" FontSize="12.5" />
              <TextBlock Text="每个 ROI 判定的 standing 颜色" Style="{StaticResource DimText}" Margin="0,1,0,0" />
            </StackPanel>
          </CheckBox>

          <CheckBox x:Name="ChkAudio" IsChecked="True" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
            <StackPanel Margin="0,1,0,3">
              <TextBlock Text="报警音频与音量" FontSize="12.5" />
              <TextBlock Text="每个 ROI 独立绑定的音频与音量" Style="{StaticResource DimText}" Margin="0,1,0,0" />
            </StackPanel>
          </CheckBox>

          <CheckBox x:Name="ChkEnabled" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
            <StackPanel Margin="0,1,0,3">
              <TextBlock Text="启用状态" FontSize="12.5" />
              <TextBlock Text="账号是否参与监控（默认不克隆）" Style="{StaticResource DimText}" Margin="0,1,0,0" />
            </StackPanel>
          </CheckBox>
        </StackPanel>

        <Border Background="{StaticResource PrimaryDimBrush}" BorderBrush="#55F0A02A" BorderThickness="1"
                CornerRadius="6" Padding="11,9" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="!" Foreground="{StaticResource PrimaryHiBrush}" FontSize="13" FontWeight="Bold"
                       Margin="0,0,9,0" />
            <TextBlock Text="目标账号的对应设置会被覆盖，未勾选的项目保持不变。此操作不可撤销。"
                       TextWrapping="Wrap" FontSize="11.5" Foreground="#FFD9AE6C" MaxWidth="400" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= 底部操作 ================= -->
      <Grid Grid.Row="2" Margin="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource DimText}"
                   Text="至少勾选一个目标账号与一个克隆项。" TextWrapping="Wrap" MaxWidth="240" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource Btn}" Content="取消" MinWidth="80" Click="OnCancelClick" />
          <Button x:Name="BtnOk" Style="{StaticResource BtnPrimary}" Content="克隆"
                  MinWidth="136" Margin="8,0,0,0" Click="OnOkClick" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
