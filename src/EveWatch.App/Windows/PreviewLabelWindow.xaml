<Window x:Class="EveWatch.App.Windows.PreviewLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览标注"
        Width="260" Height="170"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" IsHitTestVisible="False"
        FontFamily="{StaticResource BodyFont}">

  <!--
    DWM 缩略图会盖住同一窗口内的 WPF 内容，所以角色名与活动描边放在这个独立的
    透明覆盖窗里，再用 WS_EX_TRANSPARENT 让鼠标事件穿透到下面的预览窗。
  -->
  <Grid IsHitTestVisible="False">
    <Border x:Name="ActiveOutline" BorderThickness="0" BorderBrush="Transparent" CornerRadius="1" />

    <Border x:Name="NameChip" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="5,4,0,0" Padding="5,1,6,2" CornerRadius="3" Background="#99000000">
      <TextBlock x:Name="LabelText" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                 FontWeight="Bold" Foreground="#FFE3EBF2" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
