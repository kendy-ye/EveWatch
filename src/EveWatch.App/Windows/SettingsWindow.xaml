<Window x:Class="EveWatch.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="900" Height="700" MinWidth="780" MinHeight="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource BodyFont}"
        PreviewKeyDown="OnPreviewKeyDown">

  <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
          BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <!-- ================= 标题 ================= -->
      <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseDown">
        <Grid Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="⚙" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="设置" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                       Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button Style="{StaticResource BtnGhost}" Width="42" Height="42" Padding="0"
                  Content="✕" HorizontalAlignment="Right" Click="OnCloseClick" ToolTip="关闭" />
        </Grid>
      </Border>

      <!-- ================= 主体 ================= -->
      <Grid Grid.Row="1" Margin="14,12,14,0">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
          <ScrollViewer x:Name="HotkeyScroll" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Padding="16,14,16,14">
            <StackPanel>
              <TextBlock Text="快捷键" Style="{StaticResource ColumnTitle}" />
              <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="全局生效，EVE 客户端在前台时也能触发。默认未绑定；点击「绑定」后直接按下想要的按键或组合键。" />
              <TextBlock FontSize="10.5" Foreground="#FFB98A48" TextWrapping="Wrap" Margin="0,3,0,0"
                         Text="单键（如 F1）会被全系统截获，可能与其他软件或游戏冲突，建议优先使用 Ctrl / Alt / Shift / Win 组合。" />

              <ItemsControl x:Name="HotkeyList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="168" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Action.Name}" FontSize="12.5" />
                          <TextBlock Text="{Binding Action.Description}" Style="{StaticResource DimText}"
                                     TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1" Height="30" CornerRadius="6" BorderThickness="1"
                                Margin="10,0" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
                              <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                  <Setter Property="Background" Value="{StaticResource PrimaryDimBrush}" />
                                  <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding DisplayText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                     TextTrimming="CharacterEllipsis" Margin="6,0" />
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource BtnMini}" Height="26" Content="绑定"
                                  Tag="{Binding}" Click="OnBindClick" />
                          <Button Style="{StaticResource BtnMini}" Height="26" Content="清除" Margin="6,0,0,0"
                                  Tag="{Binding}" Click="OnClearClick" IsEnabled="{Binding HasBinding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="HintText" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,2,0,0" />

              <Border x:Name="ErrorBox" Visibility="Collapsed"
                      Background="{StaticResource DangerDimBrush}" BorderBrush="#55FF4D4D"
                      BorderThickness="1" CornerRadius="6" Padding="11,9" Margin="0,10,0,0">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="11.5" Foreground="#FFFF9090" />
              </Border>

              <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,14,0,0"
                         Text="客户端分组与分组快捷键已移到「客户端预览」的设置面板里。" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- ================= 底部操作 ================= -->
      <Grid Grid.Row="2" Margin="16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource BtnGhost}" Content="打开配置文件目录"
                HorizontalAlignment="Left" Click="OnOpenConfigClick" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ClearHotkeysButton" Style="{StaticResource BtnGhost}" Content="清空快捷键"
                  Click="OnClearAllClick" />
          <Button Style="{StaticResource BtnPrimary}" Content="关闭" MinWidth="88" Margin="8,0,0,0"
                  Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
