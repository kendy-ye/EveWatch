<Application x:Class="EveWatch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EveWatch.App"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <local:InverseBoolConverter x:Key="InverseBool" />
      <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
      <local:PositiveToVisibilityConverter x:Key="PositiveToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
