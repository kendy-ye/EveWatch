<Window x:Class="EveWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:EveWatch.App.ViewModels"
        Title="EveWatch · 本地预警控制台"
        Icon="pack://application:,,,/Assets/evewatch.ico"
        Height="820" Width="1360" MinHeight="560" MinWidth="1100"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        WindowStartupLocation="CenterScreen">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- 颜色色块 -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Height" Value="23" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root" CornerRadius="12" Background="{StaticResource Surface3Brush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="7,0,9,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Swatch" Width="8" Height="8" CornerRadius="2"
                        Background="{Binding Color.Hex}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{TemplateBinding Foreground}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface4Brush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#FF47576A" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 账号行 -->
    <DataTemplate x:Key="AccountRow" DataType="{x:Type vm:AccountViewModel}">
      <Border x:Name="Root" Background="{StaticResource Surface2Brush}" BorderBrush="Transparent"
              BorderThickness="1" CornerRadius="6" Padding="6,8,9,8" Margin="6,0,6,4" Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Path Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="#FF3C4854"
                Data="M0,0 h2 v2 h-2 z M5,0 h2 v2 h-2 z M0,5 h2 v2 h-2 z M5,5 h2 v2 h-2 z M0,10 h2 v2 h-2 z M5,10 h2 v2 h-2 z" />

          <StackPanel Grid.Column="1" Margin="9,0,9,0">
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Meta" Text="{Binding MetaText}" FontSize="10.5" Margin="0,3,0,0"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="Badge" Background="{StaticResource DangerDimBrush}" BorderBrush="#66FF4D4D"
                    BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"
                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
              <TextBlock x:Name="BadgeText" Text="{Binding BadgeText}" FontSize="9.5" Foreground="#FFFF9B9B" />
            </Border>
            <ToggleButton Style="{StaticResource SwitchSmall}"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          ToolTip="启用或停用该账号的监控" />
          </StackPanel>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <!-- 悬停：只提亮底色，不抢选中/敌对状态的视觉 -->
        <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
          <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3Brush}" />
        </Trigger>

        <DataTrigger Binding="{Binding Hostile}" Value="True">
          <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerDimBrush}" />
          <Setter TargetName="Root" Property="BorderBrush" Value="#55FF4D4D" />
        </DataTrigger>

        <!--
          选中态：列表项的模板是裸 ContentPresenter，没有自带选中视觉，
          所以这里从祖先 ListBoxItem 读 IsSelected。
        -->
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface3Brush}" />
          <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </DataTrigger>

        <!-- 既有敌对又是选中：背景保持告警红，描边保留选中色，两种状态都看得见 -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Hostile}" Value="True" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerDimBrush}" />
          <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </MultiDataTrigger>

        <DataTrigger Binding="{Binding Enabled}" Value="False">
          <Setter TargetName="Root" Property="Opacity" Value="0.55" />
        </DataTrigger>

        <!-- 重连中：保留原位但整体压暗，角标改用琥珀色，避免和敌对红混淆 -->
        <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
          <Setter TargetName="Root" Property="Opacity" Value="0.65" />
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource PrimaryDimBrush}" />
          <Setter TargetName="Badge" Property="BorderBrush" Value="#55F0A02A" />
          <Setter TargetName="BadgeText" Property="Foreground" Value="#FFD9AE6C" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 事件行 -->
    <DataTemplate x:Key="EventRow" DataType="{x:Type vm:EventItemViewModel}">
      <Border Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="2,0,0,0"
              CornerRadius="4" Padding="8,7" Margin="6,0,6,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                     FontSize="10.5" Foreground="{StaticResource TextDimBrush}" Margin="0,1,10,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{Binding Foreground}" />
            <TextBlock Text="{Binding Note}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{StaticResource TextDimBrush}"
                       Visibility="{Binding Note, Converter={StaticResource NotEmptyToVisibility}}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- ================= 标题栏 ================= -->
    <Border Grid.Row="0" Background="#FF0E1318" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Width="18" Height="18" CornerRadius="3" Background="{StaticResource PrimaryBrush}">
            <Border Width="10" Height="10" Background="#FF0A0D10" CornerRadius="1" />
          </Border>
          <TextBlock Text="EVEWATCH" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                     FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
          <Border Width="1" Height="18" Background="{StaticResource BorderStrongBrush}" Margin="10,0" />
          <TextBlock Text="本地预警控制台" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="BtnMinimize" Style="{StaticResource BtnGhost}" Width="42" Height="42" Padding="0"
                  Content="—" ToolTip="最小化到托盘" Click="OnMinimizeClick" />
          <Button x:Name="BtnMaximize" Style="{StaticResource BtnGhost}" Width="42" Height="42" Padding="0"
                  Content="□" ToolTip="最大化" Click="OnMaximizeClick" />
          <Button x:Name="BtnClose" Style="{StaticResource BtnGhost}" Width="42" Height="42" Padding="0"
                  Content="✕" ToolTip="关闭到托盘" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 工具栏 ================= -->
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnMonitor" Style="{StaticResource BtnPrimary}" Click="OnToggleMonitorClick">
            <TextBlock Text="{Binding MonitorButtonText}" />
          </Button>

          <Button x:Name="BtnMute" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Click="OnToggleMuteClick">
            <TextBlock Text="{Binding MuteButtonText}" />
          </Button>

          <Border Width="1" Height="22" Background="{StaticResource BorderStrongBrush}" Margin="12,0" />

          <Button x:Name="BtnClone" Style="{StaticResource BtnGhost}" Content="克隆设置" Click="OnCloneClick"
                  ToolTip="把基准账号的 ROI、命中颜色与报警音频复制到其它账号" />
          <Button x:Name="BtnWall" Margin="6,0,0,0" Click="OnWallClick"
                  ToolTip="打开或关闭 ROI 并排显示（打开后窗口内可用 Ctrl+滚轮调整画面大小）">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                <Style.Triggers>
                  <!-- 打开时加底色与描边，按钮本身就是状态指示 -->
                  <DataTrigger Binding="{Binding IsWallOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface4Brush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="{Binding WallButtonText}" />
          </Button>
          <Button x:Name="BtnLayoutSync" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Content="游戏布局同步" Click="OnLayoutSyncClick" />
          <Button x:Name="BtnIntel" Style="{StaticResource BtnGhost}" Margin="6,0,0,0" Content="频道预警"
                  Click="OnIntelSettingsClick" ToolTip="监听账号频道、跳数规则与报警声音" />
          <Button x:Name="BtnSettings" Style="{StaticResource BtnIcon}" Margin="4,0,0,0" Content="⚙" ToolTip="设置（快捷键绑定）" Click="OnSettingsClick" />

          <Border Width="1" Height="22" Background="{StaticResource BorderStrongBrush}" Margin="12,0" />

          <Button x:Name="BtnShot" Style="{StaticResource BtnGhost}" Content="导出整窗截图" Click="OnShotClick"
                  ToolTip="导出当前选中账号的整幅内容区截图，用于核对 ROI 坐标" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="监控中 " FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="6,0,0,0" />
              <TextBlock Text="{Binding MonitorSummary}" FontSize="11" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
          </Border>
          <Border Background="{StaticResource DangerDimBrush}" BorderBrush="#55FF4D4D" BorderThickness="1"
                  CornerRadius="12" Padding="10,3"
                  Visibility="{Binding HasHostile, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
              <TextBlock Text="敌对 " FontSize="11" Foreground="#FFFF9090" Margin="6,0,0,0" />
              <TextBlock Text="{Binding HostileCount}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="#FFFF7070" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 主体 ================= -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="298" />
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <!-- 账号列 -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="客户端" Style="{StaticResource ColumnTitle}" VerticalAlignment="Center" />
                <Border Background="{StaticResource Surface3Brush}" CornerRadius="9" Padding="6,1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding AccountCount}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BtnMini}" Content="全选" Click="OnSelectAllClick" ToolTip="全部启用；已全启用时改为全部停用" />
                <Button Style="{StaticResource BtnMini}" Content="反选" Click="OnInvertClick" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <ListBox x:Name="AccountList" Style="{StaticResource BareList}"
                     ItemContainerStyle="{StaticResource BareItem}"
                     ItemTemplate="{StaticResource AccountRow}"
                     ItemsSource="{Binding AccountsView}"
                     SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="OnAccountListMouseDown"
                     PreviewMouseMove="OnAccountListMouseMove"
                     Drop="OnAccountListDrop" />

            <TextBlock Text="未发现在线客户端" Style="{StaticResource DimText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasVisibleAccounts, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
          </Grid>
        </Grid>
      </Border>

      <!-- 详情列 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedAccount.Name}" FontFamily="{StaticResource MonoFont}" FontSize="16" />
              <TextBlock Text="{Binding SelectedAccount.MetaText}" Style="{StaticResource DimText}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Style="{StaticResource Btn}" Content="新增 ROI" Click="OnAddRoiClick" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <!-- 有 ROI -->
          <ScrollViewer x:Name="RoiScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,0,16"
                        Visibility="{Binding SelectedAccount.HasRois, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl x:Name="RoiList" ItemsSource="{Binding SelectedAccount.Rois}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RoiViewModel}">
                  <Border x:Name="Card" Background="{StaticResource Surface2Brush}"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                          CornerRadius="10" Margin="20,16,20,0"
                          MouseLeftButtonDown="OnRoiCardMouseDown">
                    <StackPanel>
                      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,11">
                        <Grid>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 平时是静态文本，双击才进入编辑；固定 28 高，切换时不撑动布局 -->
                            <Grid Width="190" Height="28" VerticalAlignment="Center">
                              <TextBlock x:Name="NameText" Text="{Binding Label}" FontWeight="SemiBold"
                                         Margin="9,0,0,0" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip="双击重命名"
                                         MouseLeftButtonDown="OnRoiNameMouseDown" />
                              <TextBox x:Name="NameEdit" Text="{Binding Label, UpdateSourceTrigger=Explicit}"
                                       Visibility="Collapsed" FontWeight="SemiBold"
                                       KeyDown="OnRoiNameKeyDown" LostFocus="OnRoiNameEditDone" />
                            </Grid>
                            <Border Background="{StaticResource DangerDimBrush}" BorderBrush="#55FF4D4D"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="10,0,0,0"
                                    Visibility="{Binding HitBlocks, Converter={StaticResource PositiveToVisibility}}">
                              <TextBlock Text="{Binding HitText}" FontSize="9.5" Foreground="#FFFF9B9B" />
                            </Border>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnMini}" Content="重框" Tag="{Binding}"
                                    Click="OnRoiReboxClick"
                                    ToolTip="重画这一条 ROI 的矩形，保留命中颜色与报警音频" />
                            <ToggleButton Style="{StaticResource SwitchSmall}" Margin="10,0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                            <Button Style="{StaticResource BtnIcon}" Content="🗑" Click="OnRoiDeleteClick" Tag="{Binding}"
                                    ToolTip="删除该 ROI" />
                          </StackPanel>
                        </Grid>
                      </Border>

                      <Grid Margin="14,13">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="58" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="58" Height="80" CornerRadius="4" Background="#FF070A0C"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="4">
                          <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Height="9" Margin="0,0,0,3" CornerRadius="1" Background="{Binding Hex}" Opacity="0.9" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="62" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="区域" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding BoundsText}" Style="{StaticResource MonoText}"
                                       Foreground="{StaticResource TextSubBrush}" FontSize="11.5" />
                          </Grid>

                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="62" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="命中颜色" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Colors}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="2" Style="{StaticResource BtnMini}" Content="自定义" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Tag="{Binding}" Click="OnRoiPickColorClick"
                                    ToolTip="从该 ROI 的画面取色或手动输入色值，新增到颜色库并勾选到本条 ROI" />
                          </Grid>

                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="62" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="报警音频" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <ComboBox Width="186" ItemsSource="{Binding AudioChoices}"
                                        SelectedItem="{Binding SelectedAudio, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <Button Style="{StaticResource BtnMini}" Content="试听" Margin="8,0,0,0" Tag="{Binding}"
                                      Click="OnRoiPreviewAudioClick" />
                            </StackPanel>
                          </Grid>

                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="62" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="音量" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                              <Slider Width="150" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" />
                              <TextBlock Text="{Binding VolumeText}" Style="{StaticResource MonoText}" Margin="10,0,0,0"
                                         VerticalAlignment="Center" Foreground="{StaticResource TextSubBrush}" />
                              <TextBlock Text="{Binding LastHitText}" Style="{StaticResource DimText}" Margin="18,0,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Hit}" Value="True">
                      <Setter TargetName="Card" Property="BorderBrush" Value="#66FF4D4D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                      <Setter TargetName="Card" Property="Opacity" Value="0.6" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 空状态 -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                      Visibility="{Binding SelectedAccount.HasRois, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Border Width="56" Height="56" CornerRadius="10" BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1" HorizontalAlignment="Center">
              <TextBlock Text="◎" FontSize="24" Foreground="{StaticResource TextDimBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="尚未添加 ROI" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="截取该客户端窗口，在本地成员列表左侧的图标列上拖出一个竖条区域。添加完成前该账号不会产生报警。"
                       Style="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
            <Button Style="{StaticResource BtnPrimary}" Content="新增 ROI" HorizontalAlignment="Center" Click="OnAddRoiClick" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 事件列 -->
      <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
              <TextBlock Text="事件" Style="{StaticResource ColumnTitle}" VerticalAlignment="Center" />
              <Button Style="{StaticResource BtnMini}" Content="清空" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="OnClearEventsClick" />
            </Grid>
          </Border>

          <ListBox Grid.Row="1" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource BareItem}"
                   ItemTemplate="{StaticResource EventRow}" ItemsSource="{Binding Events}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ================= 状态栏 ================= -->
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
        <TextBlock Text="采集 " Style="{StaticResource DimText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ChannelText}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0" />
        <TextBlock Text="节拍 " Style="{StaticResource DimText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TickText}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0" />
        <TextBlock Text="CPU " Style="{StaticResource DimText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CpuText}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0" />
        <TextBlock Text="内存 " Style="{StaticResource DimText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
        <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0" />
        <TextBlock Text="配置 " Style="{StaticResource DimText}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ConfigPathText}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource TextSubBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
